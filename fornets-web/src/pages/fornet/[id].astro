---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const fornets = await getCollection('fornets');
  return fornets.map((fornet) => ({
    params: { id: fornet.id },
    props: { fornet },
  }));
}

const { fornet } = Astro.props;
const { data } = fornet;
const { Content } = await render(fornet);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={`${data.nom} — Fornets`}>
  <p class="tornar"><a href={`${base}/`}>← Torna al catàleg</a></p>
  <h1>{data.nom}</h1>
  {data.marca && <p class="subtitol">{data.marca}</p>}

  <dl class="fitxa">
    <div>
      <dt>Material</dt>
      <dd>{data.material}</dd>
    </div>
    <div>
      <dt>Capacitat màxima</dt>
      <dd>{data.capacitatMl} ml</dd>
    </div>
    <div>
      <dt>Ebullició de 300 ml</dt>
      <dd>{data.tempsEbullicio300Min} min</dd>
    </div>
    <div>
      <dt>Pes</dt>
      <dd>{data.pesG} g</dd>
    </div>
    <div>
      <dt>Mida</dt>
      <dd>{data.mida}</dd>
    </div>
    <div>
      <dt>Suport per a l'olla</dt>
      <dd>{data.necessitaSuport ? 'Necessari' : 'No cal'}</dd>
    </div>
  </dl>

  <article class="cos">
    <Content />
  </article>
</Base>
