---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StoveVisual from '../../components/StoveVisual.astro';

export async function getStaticPaths() {
  const fornets = await getCollection('fornets');
  return fornets.map((fornet) => ({
    params: { id: fornet.id },
    props: { fornet },
  }));
}

const { fornet } = Astro.props;
const { data } = fornet;
const { Content } = await render(fornet);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/** Decimals amb coma, com toca en català (4.7 → «4,7»). */
const fmt = (n: number) => String(n).replace('.', ',');

/** Segons → «m:ss min» (280 → «4:40 min»). */
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')} min`;
---

<Base title={`${data.nom} — Fornets`}>
  <p class="tornar"><a href={`${base}/`}>← Torna al catàleg</a></p>

  <div class="fitxa-graella">
    <div class="escenari">
      <span class="xapa-material">{data.material}</span>
      <StoveVisual fornet={fornet} />
    </div>

    <div class="info">
      {data.marca && <p class="eyebrow">{data.marca}</p>}
      <h1>{data.nom}</h1>
      <ul class="etiquetes">
        <li>{data.mida}</li>
        <li>{data.necessitaSuport ? 'cal suport extern' : 'suport integrat'}</li>
      </ul>

      <dl class="fitxa">
        <div>
          <dt>Material</dt>
          <dd>{data.material}</dd>
        </div>
        <div>
          <dt>Ebullició de 300 ml</dt>
          <dd class:list={[!data.tempsEbullicio300S && 'pendent']}>
            {data.tempsEbullicio300S ? mmss(data.tempsEbullicio300S) : 'Pendent de prova'}
          </dd>
        </div>
        <div>
          <dt>Pes</dt>
          <dd>{fmt(data.pesG)} g</dd>
        </div>
        <div>
          <dt>Mida</dt>
          <dd>{data.mida}</dd>
        </div>
        <div>
          <dt>Suport per a l'olla</dt>
          <dd>{data.necessitaSuport ? 'Necessari' : 'No cal'}</dd>
        </div>
        <div>
          <dt>Funciona</dt>
          <dd class:list={[!data.funciona && 'no-funciona']}>{data.funciona ? 'Sí' : 'No'}</dd>
        </div>
      </dl>
    </div>
  </div>

  <article class="cos">
    <Content />
  </article>
</Base>

<style>
  .tornar {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin: 0 0 1.5rem;
  }

  .tornar a {
    text-decoration: none;
  }

  .tornar a:hover {
    text-decoration: underline;
  }

  .fitxa-graella {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 2.25rem;
    align-items: start;
  }

  @media (max-width: 44rem) {
    .fitxa-graella {
      grid-template-columns: 1fr;
    }
  }

  .info {
    display: grid;
    gap: 0.4rem;
  }

  .info h1 {
    font-size: clamp(1.9rem, 5vw, 2.7rem);
  }

  ul.etiquetes {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.2rem 0 0.8rem;
    padding: 0;
  }

  /* Etiquetes com de cinta retolada, a joc amb la xapa de material. */
  ul.etiquetes li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-strong);
    border: 1px dashed var(--border-strong);
    border-radius: 3px;
    padding: 0.25rem 0.7rem;
  }

  /* La fitxa tècnica: l'única targeta de la columna, el punt focal. */
  dl.fitxa {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 0.5rem 1.25rem;
    margin: 0;
  }

  dl.fitxa > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
  }

  dl.fitxa > div:last-child {
    border-bottom: none;
  }

  dl.fitxa dt {
    color: var(--text-secondary);
  }

  dl.fitxa dd {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 600;
    text-align: right;
  }

  dl.fitxa dd.pendent {
    color: var(--text-faint);
    font-weight: 400;
  }

  dl.fitxa dd.no-funciona {
    color: var(--ember);
  }

  article.cos {
    margin-top: 2rem;
    max-width: 42rem;
    color: var(--text-strong);
  }
</style>
